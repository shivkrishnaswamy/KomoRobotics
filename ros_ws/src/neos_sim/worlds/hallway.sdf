<?xml version="1.0" ?>
<!--
  Hallway world for gz sim (Harmonic / SDF 1.9)

  Layout (top view, +x is down the hallway, origin at the open start):

        y=+1.05  ████████████████████████████████████████  left wall
                 (open start)   [ 10 m long ]   ▓▓▓▓  end wall + painted elevator door
        y=-1.05  ████████████████████████████████████████  right wall

  Interior width : 2.0 m   (y from -1.0 to +1.0)
  Interior length: 10.0 m  (x from 0.0 to 10.0)
  Wall height    : 2.5 m
  Wall thickness : 0.1 m

  The start of the hallway (x = 0) is open so the robot can be spawned there
  and driven in. The elevator door is visual only (no collision), painted on
  the inner face of the end wall at x = 10.0.
-->
<sdf version="1.9">
  <world name="hallway_world">

    <!-- Physics and core systems -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.88 0.92 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>5 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.1 -1</direction>
    </light>

    <!-- Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Hallway walls (collision + visual) -->
    <model name="hallway">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <!-- Left wall (y = +1.05) -->
      <link name="left_wall">
        <pose>5 1.05 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.2 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.92 0.90 0.85 1</ambient>
            <diffuse>0.92 0.90 0.85 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Right wall (y = -1.05) -->
      <link name="right_wall">
        <pose>5 -1.05 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.2 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.92 0.90 0.85 1</ambient>
            <diffuse>0.92 0.90 0.85 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- End wall (inner face at x = 10.0) -->
      <link name="end_wall">
        <pose>10.05 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 2.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.2 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.83 0.78 1</ambient>
            <diffuse>0.85 0.83 0.78 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Painted elevator door: visual only, no collision.
      Everything sits flush against the end wall's inner face (x = 10.0).
      Frame spans x 9.990-10.000, door panels span 9.985-9.995 so they
      sit slightly proud of the frame and avoid z-fighting.
    -->
    <model name="elevator_door_painted">
      <static>true</static>

      <!-- Dark frame: 1.3 m wide x 2.2 m tall -->
      <link name="frame">
        <pose>9.995 0 1.1 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.01 1.3 2.2</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.17 1</ambient>
            <diffuse>0.15 0.15 0.17 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Left door panel (brushed metal look) -->
      <link name="door_left">
        <pose>9.99 0.31 1.05 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.01 0.6 2.1</size></box></geometry>
          <material>
            <ambient>0.65 0.67 0.70 1</ambient>
            <diffuse>0.65 0.67 0.70 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>

      <!-- Right door panel -->
      <link name="door_right">
        <pose>9.99 -0.31 1.05 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.01 0.6 2.1</size></box></geometry>
          <material>
            <ambient>0.65 0.67 0.70 1</ambient>
            <diffuse>0.65 0.67 0.70 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
      </link>

      <!-- Call button plate, to the right of the door (as seen from the hallway) -->
      <link name="call_plate">
        <pose>9.995 -0.9 1.1 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.01 0.12 0.24</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.32 1</ambient>
            <diffuse>0.3 0.3 0.32 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Glowing call button -->
      <link name="call_button">
        <pose>9.99 -0.9 1.1 0 0 0</pose>
        <visual name="visual">
          <geometry><box><size>0.01 0.05 0.05</size></box></geometry>
          <material>
            <ambient>1 0.6 0.1 1</ambient>
            <diffuse>1 0.6 0.1 1</diffuse>
            <emissive>1 0.6 0.1 1</emissive>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
