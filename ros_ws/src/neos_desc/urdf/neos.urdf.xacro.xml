<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="komo">

  <!--
    Frame conventions (REP-103):
      +x = forward, +y = left, +z = up
    base_link sits at the geometric center of the body box.

    Side view (x to the right):            Top view (x up):

          +===========+                     c===========c      c = caster
          |           |                     |           |
          |   body    |                   [W]   body    [W]    W = drive wheel
          |           |                     |           |
          +===========+                     c===========c
          c    (W)    c
     ______________________  ground
  -->

  <!-- ===================== PROPERTIES ===================== -->
  <xacro:property name="PI" value="3.14159265359" />

  <!-- BODY -->
  <xacro:property name="length" value="0.54" />
  <xacro:property name="width"  value="0.60" />
  <xacro:property name="total_robot_height" value="1.052" />
  <xacro:property name="mass"   value="30.0" />

  <!-- DRIVE WHEELS -->
  <xacro:property name="wheel_radius" value="0.10" />
  <xacro:property name="wheel_width"  value="0.04" />
  <xacro:property name="wheel_mass"   value="0.5" />
  <xacro:property name="wheel_gap"    value="0.01" />  <!-- space between body side and wheel -->
  <!-- Wheel center sits just outside the body on each side -->
  <xacro:property name="wheel_y" value="${width/2 + wheel_gap + wheel_width/2}" />
  <!-- Distance between the two wheel centers (the DiffDrive plugin needs this) -->
  <xacro:property name="wheel_separation" value="${2*wheel_y}" />

  <!-- CASTER WHEELS (FRICTIONLESS) -->
  <!-- Real casters are 4 in dia x 1.2 in thick. Modeled as 10 cm spheres so they slide/turn freely in sim -->
  <xacro:property name="caster_radius" value="0.05" />
  <xacro:property name="caster_mass"   value="0.1" />
  <!-- Caster center distance in from each body edge: radius + 1 cm, so the caster stays fully under the body -->
  <xacro:property name="caster_inset"  value="${caster_radius + 0.01}" />
  <!--
    Casters are lifted a few mm above the ground. With 2 drive wheels + 4 casters, all six contacts can't share the weight evenly. 
    If every caster touches, the drive wheels can end up carrying almost no load and slip. With the small lift, the drive wheels 
    always carry the weight, and the casters only catch the robot when it rocks forward or back.
  -->
  <xacro:property name="caster_lift"   value="0.003" />

  <!-- VERTICAL LAYOUT -->
  <xacro:property name="ground_clearance" value="${2*caster_radius}" />   <!-- Gap between body bottom and floor -->
  <xacro:property name="height" value="${total_robot_height - ground_clearance}" />   <!-- Body box height -->
  <xacro:property name="ground_z" value="${-height/2 - ground_clearance}" />   <!-- z of the floor, relative to base_link (body center) -->

  <!-- ===================== MACROS ===================== -->

  <!-- DRIVE WHEELS
    Adding a wheel only needs a name and a position: <xacro:wheel prefix="left_" y="${wheel_y}"/>

    Required:
      prefix : name prefix, e.g. "left_" -> creates left_wheel_link + left_wheel_joint
      y      : side-to-side position of the wheel center (+ = left, - = right)
    Optional (defaults come from the properties above):
      x      : front/back position of the wheel center (default 0 = centered)
      parent, radius, width, mass
    Height is automatic: the wheel center is placed one radius above the floor so it always touches the ground.

    The wheel spins about its own Y axis (cylinder rotated 90 deg about X).
    A positive joint velocity rolls the robot forward (+x) on BOTH sides, which is what DiffDrive expects.
  -->
  <xacro:macro name="wheel" params="prefix y x:=0 parent:=base_link radius:=${wheel_radius} width:=${wheel_width} mass:=${wheel_mass}">

    <link name="${prefix}wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <inertia ixx="${mass*(3*radius*radius + width*width)/12}" ixy="0" ixz="0"
                 iyy="${mass*(3*radius*radius + width*width)/12}" iyz="0"
                 izz="${mass*radius*radius/2}"/>
      </inertial>
    </link>

    <joint name="${prefix}wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}wheel_link"/>
      <origin xyz="${x} ${y} ${ground_z + radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Gazebo surface properties: high friction so the wheels grip -->
    <gazebo reference="${prefix}wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

  </xacro:macro>

  <!-- CASTER WHEELS
    Adding a caster only needs a name and a position: <xacro:caster prefix="front_left_" x="${caster_x}" y="${caster_y}"/>

    Required:
      prefix : name prefix, e.g. "front_left_" -> creates front_left_caster_link + front_left_caster_joint
      x, y   : position of the caster center (+x = front, +y = left)
    Optional (defaults come from the properties above):
      parent, radius, mass
    Height is automatic: the caster bottom is placed caster_lift above the floor.

    The caster is a sphere on a FIXED joint with zero friction. It doesn't actually rotate. It just slides
    over the floor in any direction, which acts like a free-swiveling caster. This is the usual simple
    way to do casters in simulation.
  -->
  <xacro:macro name="caster"
               params="prefix x y parent:=base_link radius:=${caster_radius} mass:=${caster_mass}">

    <link name="${prefix}caster_link">
      <visual>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="caster_grey">
          <color rgba="0.6 0.6 0.6 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="${mass}"/>
        <!-- Solid sphere inertia -->
        <inertia ixx="${2*mass*radius*radius/5}" ixy="0" ixz="0"
                 iyy="${2*mass*radius*radius/5}" iyz="0"
                 izz="${2*mass*radius*radius/5}"/>
      </inertial>
    </link>

    <joint name="${prefix}caster_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}caster_link"/>
      <origin xyz="${x} ${y} ${ground_z + radius + caster_lift}" rpy="0 0 0"/>
    </joint>

    <!-- Frictionless so the caster slides in any direction -->
    <gazebo reference="${prefix}caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

  </xacro:macro>

  <!-- ===================== LINKS ===================== -->

  <!-- Base Link (The Chassis) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${length} ${width} ${height}"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${length} ${width} ${height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${mass}"/>
      <!-- Solid box inertia -->
      <inertia ixx="${mass*(width*width + height*height)/12}" ixy="0.0" ixz="0.0"
               iyy="${mass*(length*length + height*height)/12}" iyz="0.0"
               izz="${mass*(length*length + width*width)/12}"/>
    </inertial>
  </link>

  <!-- Drive wheels: centered front/back, just outside each side, touching the ground -->
  <xacro:wheel prefix="left_"  y="${ wheel_y}"/>
  <xacro:wheel prefix="right_" y="${-wheel_y}"/>

  <!-- Casters: one under each corner of the body -->
  <xacro:property name="caster_x" value="${length/2 - caster_inset}" />
  <xacro:property name="caster_y" value="${width/2 - caster_inset}" />

  <xacro:caster prefix="front_left_"  x="${ caster_x}" y="${ caster_y}"/>
  <xacro:caster prefix="front_right_" x="${ caster_x}" y="${-caster_y}"/>
  <xacro:caster prefix="rear_left_"   x="${-caster_x}" y="${ caster_y}"/>
  <xacro:caster prefix="rear_right_"  x="${-caster_x}" y="${-caster_y}"/>

  <!-- ===================== Gazebo Plugins ===================== -->
  <!--
    The plugin is the simulated motor controller. It reads /cmd_vel, converts it into left and right wheel speeds and spins
    the wheel joints, and the physics engine moves the robot through friction with the floor. It also integrates wheel motion 
    into an odometry estimate published on /odom.
  -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- TOPICS: must match the ros_gz_bridge args in sim.launch.py -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <!-- LIMITS. The robot is tall (~1 m) and top-heavy, so keep acceleration gentle to avoid tipping it over -->
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>
  </gazebo>

</robot>