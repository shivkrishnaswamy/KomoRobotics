<?xml version="1.0"?>
<!--
  GAZEBO / SIM SETTINGS

  Everything here only matters in Gazebo. Tools outside Gazebo (robot_state_publisher, RViz, the real robot) ignore it
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== DIFF DRIVE PLUGIN ===================== -->
  <!--
    The plugin is the simulated motor controller. It reads /cmd_vel, converts it into left and right wheel speeds and spins
    the wheel joints, and the physics engine moves the robot through friction with the floor. It also integrates wheel motion
    into an odometry estimate published on /odom.
  -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <!-- TOPICS: must match the ros_gz_bridge args in sim.launch.py -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>/tf</tf_topic>  <!-- Publishes the odom -> base_link transform (bridged to ROS /tf in sim.launch.py) -->

      <!-- LIMITS. The robot is tall (~1 m), so keep acceleration gentle for now to avoid tipping over -->
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <min_angular_acceleration>-3.0</min_angular_acceleration>
    </plugin>
  </gazebo>

  <!-- ===================== JOINT STATE PUBLISHER ===================== -->
  <!--
    Publishes the simulated joint angles (the wheels) on /joint_states, so robot_state_publisher can place the wheel
    frames in TF. On the real robot, the motor controller node publishes /joint_states from the wheel encoders instead.
  -->
  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>