<?xml version="1.0"?>
<!--
  NEOS RGB-D CAMERA
  Luxonis OAK-D Pro (fixed focus version)

  Camera specs are for the stereo pair (depth camera)
  - Camera HFOV is 80 deg
  - Camera resolution is up to 1280x800
  - Camera frame rate is up to 255FPS(limited for sim)
  - Cameras baseline is 7.5cm (distance between left and right stereo cameras)
  - The ideal depth range is 70cm - 12m with a max effective range of 30m
    Min range can be reduced to about 35cm by changing the res to 640x400 and enabling extended disparity

  We currently use 'raw stereo depth' but can switch to 'depth algined to colour' which reprojects depth onto 
  the color camera's view, so pixel (x, y) in the color image and pixel (x, y) in the depth image are the same point.
  Enables coloured point clouds but have a narrower FOV.
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Physical Specs ===================== -->
  <xacro:property name="cam_depth"  value="0.0231" />  <!-- front to back-->
  <xacro:property name="cam_width"  value="0.097" />   <!-- size to side -->
  <xacro:property name="cam_height" value="0.0295" />  <!-- top to bottom -->

  <!-- ===================== Camera Specs ===================== -->
  <xacro:property name="cam_hfov"   value="1.396" /> 
  <xacro:property name="cam_res_w"  value="1280" />
  <xacro:property name="cam_res_h"  value="800" />
  <xacro:property name="cam_rate"   value="30" />
  <xacro:property name="cam_near"   value="0.70" />
  <xacro:property name="cam_far"    value="30.0" />

  <!-- ===================== CAMERA BODY ===================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="${cam_depth} ${cam_width} ${cam_height}"/></geometry>
      <material name="camera_black"><color rgba="0 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${cam_depth} ${cam_width} ${cam_height}"/></geometry>
    </collision>
  </link>

  <!-- Centered on the front face, 5 cm below the top of the body -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${length/2 + cam_depth/2} 0 ${height - 0.05}" rpy="0 0 0"/>
  </joint>

  <!--Optical frame: ROS image convention is z forward, x right, y down (REP-103) -->
  <link name="camera_optical_link"/>
  
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ===================== GAZEBO SENSOR ===================== -->
  <!-- Publishes: /camera/image, /camera/depth_image, /camera/points, /camera/camera_info (bridged in sim.launch.py) -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>${cam_rate}</update_rate>
      <visualize>true</visualize>
      <topic>/camera</topic>
      <ignition_frame_id>camera_optical_link</ignition_frame_id>
      <camera>
        <horizontal_fov>${cam_hfov}</horizontal_fov>
        <image>
          <width>${cam_res_w}</width>
          <height>${cam_res_h}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>${cam_near}</near>
          <far>${cam_far}</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>